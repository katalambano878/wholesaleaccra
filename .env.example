# =============================================================================
# Copy this file to `.env.local` and fill in your own values. NEVER commit
# real keys. Every value below is a placeholder for the new owner to replace.
# =============================================================================

# --- Site URL (required for SEO, sitemap, emails) ---
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# --- Branding & contact (shown across the site; override in CMS where available) ---
NEXT_PUBLIC_WORDMARK=YOUR_BRAND_NAME
NEXT_PUBLIC_SITE_NAME=YOUR_STORE_NAME
NEXT_PUBLIC_SITE_TAGLINE=YOUR_TAGLINE
NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=
# Optional: E.164 for tel: links if display phone differs
NEXT_PUBLIC_CONTACT_PHONE_TEL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Optional social handles (leave blank to hide; add your own URLs / handles)
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_HANDLE=
# NEXT_PUBLIC_SOCIAL_TIKTOK=
# NEXT_PUBLIC_SOCIAL_TIKTOK_HANDLE=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_YOUTUBE_HANDLE=
# NEXT_PUBLIC_SOCIAL_SNAPCHAT=
# NEXT_PUBLIC_SOCIAL_SNAPCHAT_HANDLE=

NEXT_PUBLIC_SMS_SENDER_ID=STORE
NEXT_PUBLIC_SKU_PREFIX=SKU

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Database migrations (npm run db:migrate) — use Session pooler URI from Supabase → Settings → Database
# Or SUPABASE_DB_PASSWORD + NEXT_PUBLIC_SUPABASE_URL (pooler host uses SUPABASE_POOLER_REGION, default us-east-1).
DATABASE_URL=
SUPABASE_POOLER_REGION=us-east-1
# If core schema already exists: SKIP_COMPLETE_SCHEMA=1 npm run db:migrate

# Email (Resend) — replace with your own Resend account values
RESEND_API_KEY=YOUR_RESEND_API_KEY
ADMIN_EMAIL=admin@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com

# SMS / Mobile Money (Moolre) — replace with your own Moolre credentials
MOOLRE_SMS_API_KEY=
MOOLRE_API_KEY=
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=merchant@yourdomain.com
MOOLRE_CALLBACK_SECRET=

# Optional: Analytics & reCAPTCHA
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cron (payment reminders)
CRON_SECRET=
